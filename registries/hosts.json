{
  "$comment": "Host-adapter registry. Single source of truth for multi-tool distribution. The core (AGENTS.md, agents/, command/, skills/) is host-agnostic; every supported host is a self-describing adapter instance below. The installer and manifest generator read THIS file; no hardcoded tool list lives in the core. Adding a host = adding an entry. Schema: code (stable id), config_dir (where symlinks land), config_file (filename AGENTS.md is symlinked as), surfaces.{skills,commands,agents} (what the host consumes), surfaces.agents_path (subdir name for agents, null when agents is false).",
  "contract": {
    "config_dir": "$HOME/<dotdir>",
    "config_file": "<doctrine>.md",
    "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null }
  },
  "adapters": [
    { "code": "gemini",         "config_dir": "$HOME/.gemini",            "config_file": "GEMINI.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "antigravity",    "config_dir": "$HOME/.gemini",            "config_file": "GEMINI.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "antigravity-ide","config_dir": "$HOME/.gemini",            "config_file": "GEMINI.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "codex",          "config_dir": "$HOME/.codex",             "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "claude",         "config_dir": "$HOME/.claude",            "config_file": "CLAUDE.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "qwen",           "config_dir": "$HOME/.qwen",              "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": true, "agents": false, "agents_path": null } },
    { "code": "opencode",       "config_dir": "$HOME/.config/opencode",   "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": true, "agents": true,  "agents_path": "agents" } },
    { "code": "kilo",           "config_dir": "$HOME/.config/kilo",       "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": true, "agents": true,  "agents_path": "agent" } },
    { "code": "openclaw",      "config_dir": "$HOME/.openclaw/workspace", "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": false, "agents": false, "agents_path": null } },
    { "code": "hermes",        "config_dir": "$HOME/.hermes",             "config_file": "SOUL.md",   "surfaces": { "skills": true, "commands": false, "agents": false, "agents_path": null } },
    { "code": "pi",            "config_dir": "$HOME/.pi/agent",           "config_file": "AGENTS.md", "surfaces": { "skills": true, "commands": false, "agents": false, "agents_path": null } }
  ]
}
